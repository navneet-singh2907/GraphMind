# Nebius API (Token Factory)
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1/

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# Model names
LLM_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
MODEL_TIMEOUT_SECONDS=45
MODEL_MAX_RETRIES=1
AGENT_MAX_ATTEMPTS=2

# Container startup
# Builds ephemeral processed/vector indexes from the bundled synthetic demo corpus.
GRAPHMIND_BOOTSTRAP_DEMO=true
PORT=8501

# Optional ontology override (JSON). Relative paths resolve from the project root.
ONTOLOGY_PATH=config/default_ontology.json
